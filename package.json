{
  "name": "toca-desktop",
  "productName": "Toca",
  "version": "2.0.0",
  "private": true,
  "description": "Toca - chamadas de voz em grupo",
  "license": "GPL-3.0-or-later",
  "repository": "github:tonyalbert/toca-desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:audio-helper && electron-vite dev",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:avatar": "node scripts/test-avatar-desktop.mjs",
    "dist": "npm run build:audio-helper && electron-vite build && electron-builder --win --publish never",
    "release": "npm run dist && node scripts/publish-github.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "build:audio-helper": "node scripts/build-audio-helper.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "author": "tonyalbert"
}
